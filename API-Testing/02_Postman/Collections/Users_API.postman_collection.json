{
  "info": {
    "name": "Users API",
    "description": "Postman collection for testing Users API: CRUD operations, search, validation and negative scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 — GET Users",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('User has an ID', function () { pm.expect(pm.response.json()).to.have.property('id'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get User — Invalid ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/abc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get User — Not Found",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — POST Users",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Egor\",\n  \"lastName\": \"Ivanov\",\n  \"age\": 30,\n  \"city\": \"Tiraspol\",\n  \"country\": \"Moldova\",\n  \"nationality\": \"Moldovan\"\n}"
            },
            "url": "{{baseUrl}}/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });",
                  "pm.test('Created user contains required fields', function () {",
                  "  const user = pm.response.json()[0];",
                  "  pm.expect(user).to.include.all.keys('id', 'firstName', 'lastName', 'age', 'city', 'country', 'nationality');",
                  "  pm.collectionVariables.set('userId', user.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create User — Invalid Age",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Egor\",\n  \"lastName\": \"Ivanov\",\n  \"age\": 150,\n  \"city\": \"Tiraspol\",\n  \"country\": \"Moldova\",\n  \"nationality\": \"Moldovan\"\n}"
            },
            "url": "{{baseUrl}}/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Multiple Users",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"firstName\": \"Alex\",\n    \"lastName\": \"Petrov\",\n    \"age\": 28,\n    \"city\": \"Chisinau\",\n    \"country\": \"Moldova\",\n    \"nationality\": \"Moldovan\"\n  },\n  {\n    \"firstName\": \"Maria\",\n    \"lastName\": \"Popova\",\n    \"age\": 25,\n    \"city\": \"Tiraspol\",\n    \"country\": \"Moldova\",\n    \"nationality\": \"Moldovan\"\n  }\n]"
            },
            "url": "{{baseUrl}}/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Two users were created', function () { pm.expect(pm.response.json()).to.have.lengthOf(2); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 — Search Users",
      "item": [
        {
          "name": "Search by First Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/search?firstName=Egor&page=1&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response contains pagination fields', function () {",
                  "  pm.expect(pm.response.json()).to.include.all.keys('page', 'limit', 'total', 'data');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Search — Invalid Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/search?page=0&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 — PUT User",
      "item": [
        {
          "name": "Replace User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Egor\",\n  \"lastName\": \"Ivanov\",\n  \"age\": 31,\n  \"city\": \"Tiraspol\",\n  \"country\": \"Moldova\",\n  \"nationality\": \"Moldovan\"\n}"
            },
            "url": "{{baseUrl}}/users/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Age was updated', function () { pm.expect(pm.response.json().age).to.eql(31); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 — PATCH User",
      "item": [
        {
          "name": "Update User City",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"Chisinau\"\n}"
            },
            "url": "{{baseUrl}}/users/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('City was updated', function () { pm.expect(pm.response.json().city).to.eql('Chisinau'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PATCH — Empty Body",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/users/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 — DELETE Users",
      "item": [
        {
          "name": "Delete User by ID",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Success message is returned', function () { pm.expect(pm.response.json().message).to.eql('User deleted'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Delete Users — Without Filters",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
